<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    tools:context=".exploreActivity.BookInfoActivity">
    <!--제목 , 웹소설 커버 이미지 , 카테고리 , 작성자 , 평가 정보를 가져오고 , 리사이클러뷰에는 회차 정보 ( 열람 정보 )  , 댓글 정보를 -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/mToolBar_bookInfo"
                style="@style/Widget.MaterialComponents.Toolbar.Primary"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:menu="@menu/menu_book_info"
                app:buttonGravity="center_vertical"
                app:navigationIcon="@drawable/arrow_left_solid"
                app:title="@string/title_text"
                app:titleCentered="true" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Note: A RecyclerView can also be used -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5sp">
                <!-- book info card view -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_BookInfoAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10sp"
                    app:cardCornerRadius="20sp"
                    app:cardElevation="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_BookInfoAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="200sp"
                        android:padding="10sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.5" />

                        <ImageView
                            android:id="@+id/imageView_bookCover"
                            android:layout_width="0dp"
                            android:layout_height="150dp"
                            android:layout_marginVertical="10sp"
                            android:maxHeight="200sp"
                            android:src="@drawable/sample_bookcover"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/guideline"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.4" />

                        <LinearLayout
                            android:id="@+id/layout_bookInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5sp"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/guideline"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.5">

                            <TextView
                                android:id="@+id/textView_bookTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="10sp"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:gravity="center"
                                android:justificationMode="inter_word"
                                android:text="@string/title_text"
                                android:textFontWeight="700"
                                android:textSize="18sp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="@string/category_text"
                                    android:textStyle="bold" />
                            <TextView
                                android:layout_marginStart="10sp"
                                android:id="@+id/textView_bookCategory"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:text="@string/sample_category_text"
                                android:textFontWeight="500" />
                            </LinearLayout>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textStyle="bold"
                                    android:text="@string/writer_novel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            <TextView
                                android:layout_marginStart="10sp"
                                android:id="@+id/textView_writerName"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:text="@string/sample_userName"
                                android:textFontWeight="500" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textStyle="bold"
                                    android:text="@string/view_novel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                            <TextView
                                android:layout_marginStart="10sp"
                                android:id="@+id/textView_views"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:text="@string/view_novel"
                                android:textFontWeight="500" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                            <ImageView
                                android:src="@drawable/star_regular_on_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@string/review_rating" />
                            <TextView
                                android:id="@+id/textView_rating"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:text="@string/review_rating"
                                android:textFontWeight="500" />
                            </LinearLayout>

                            <!--                            <TextView-->
                            <!--                                android:id="@+id/textView_bookSummary"-->
                            <!--                                android:fontFamily="@font/ibm_plex_sans_medium"-->
                            <!--                                android:textFontWeight="500"-->
                            <!--                                android:layout_width="match_parent"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:text="@string/sample_summary_text"/>-->
                            <TextView
                                android:id="@+id/textView_createDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:text="@string/sample_date_text"
                                android:textFontWeight="500" />


                        </LinearLayout>

                        <Button
                            android:id="@+id/button_addLikes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5sp"
                            android:text="@string/set_like_string"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline"
                            app:layout_constraintTop_toBottomOf="@id/layout_bookInfo"
                            app:layout_constraintWidth_percent="0.5" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <!--줄거리  card View-->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10sp"
                    android:layout_marginVertical="10sp"
                    android:onClick="expand"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="5sp"
                    app:layout_constraintBottom_toTopOf="@+id/cardView_chapter"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardView_BookInfoAll">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="15sp">


                        <LinearLayout
                            android:id="@+id/layout_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:animateLayoutChanges="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:text="@string/summary_text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5sp"
                                android:background="@color/white"
                                android:maxLines="2"
                                android:textSize="14sp"
                                android:layout_marginHorizontal="10sp"
                                android:ellipsize="end"
                                android:text="@string/sample_summary_text"
                                android:id="@+id/textView_bookSummary_short"/>

                            <TextView
                                android:layout_marginTop="5sp"
                                android:id="@+id/textView_bookSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/white"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:layout_marginHorizontal="10sp"
                                android:text="@string/sample_summary_text"
                                android:textSize="14sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imageView_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="24sp"
                            android:layout_gravity="center"
                            android:layout_marginTop="5sp"
                            android:src="@drawable/caret_down_solid" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <!-- 회차 정보 card view -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_chapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10sp"
                    android:layout_marginTop="5sp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="10dp"
                    app:layout_constraintBottom_toTopOf="@+id/cardView_comment"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardView_summary">

                    <androidx.constraintlayout.widget.ConstraintLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10sp">


                        <Button
                            android:id="@+id/button_readContinue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/continue_read_string"
                            app:layout_constraintStart_toEndOf="@id/button_readFirst"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.45" />

                        <Button
                            android:id="@+id/button_readFirst"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/first_read_string"
                            app:layout_constraintEnd_toStartOf="@+id/button_readContinue"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.45" />

                        <LinearLayout
                            android:id="@+id/layout_chapterShow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="5sp"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/button_moreChapterItem"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/guideline1">
                            <!--새로 추가함 변경 -->
                            <TextView
                                android:id="@+id/textView_chapterInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5sp"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:gravity="center"
                                android:text="회차"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/ibm_plex_sans_medium"
                                android:gravity="start"
                                android:text="@string/chapter_indicator_string"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <!--새로 추가함 변경 -->
                            <!--                            <TextView-->
                            <!--                                android:layout_width="wrap_content"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:layout_gravity="start"-->
                            <!--                                android:layout_weight="1"-->
                            <!--                                android:fontFamily="@font/ibm_plex_sans_medium"-->
                            <!--                                android:text="회차" />-->

                            <!--                            <TextView-->
                            <!--                                android:layout_width="wrap_content"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:layout_gravity="center"-->
                            <!--                                android:layout_weight="1"-->
                            <!--                                android:fontFamily="@font/ibm_plex_sans_medium"-->
                            <!--                                android:gravity="center"-->
                            <!--                                android:text="제목" />-->
                            <!-- 정렬 옵션 선택 레이아웃 , 최신순 , 등록순  옵션 선택-->
                            <!--                            <LinearLayout-->
                            <!--                                android:orientation="horizontal"-->
                            <!--                                android:id="@+id/layout_arrayOption"-->
                            <!--                                android:layout_width="wrap_content"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:layout_gravity="end"-->
                            <!--                                android:layout_weight="1"-->
                            <!--                                android:gravity="end">-->

                            <!--&lt;!&ndash;                                <TextView&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:id="@+id/textView_arrayOption"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:layout_width="wrap_content"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:layout_height="match_parent"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:layout_weight="1"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:fontFamily="@font/ibm_plex_sans_medium"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:gravity="end"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:text="최신순" />&ndash;&gt;-->

                            <!--&lt;!&ndash;                                <ImageView&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:id="@+id/imageView_array"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:layout_width="24dp"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:layout_height="24dp"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:layout_weight="1"&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    android:src="@drawable/arraylist_icon" />&ndash;&gt;-->
                            <!--                            </LinearLayout>-->
                        </LinearLayout>

                        <!--                        <androidx.recyclerview.widget.RecyclerView-->
                        <!--                            android:id="@+id/recycler_view_chapter"-->
                        <!--                            android:layout_width="match_parent"-->
                        <!--                            android:layout_height="wrap_content"-->
                        <!--                            android:minHeight="20sp"-->
                        <!--                            app:layout_constraintEnd_toEndOf="parent"-->
                        <!--                            app:layout_constraintStart_toStartOf="parent"-->
                        <!--                            app:layout_constraintTop_toBottomOf="@id/layout_chapterShow" />-->
                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintGuide_percent="0.5"
                            app:layout_constraintTop_toBottomOf="@id/button_readContinue" />

                        <Button
                            android:id="@+id/button_moreChapterItem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10sp"
                            android:text="@string/more"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/guideline1"
                            app:layout_constraintWidth_percent="0.3" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10sp"
                    android:layout_marginVertical="20sp"
                    app:cardCornerRadius="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardView_chapter">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10sp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="15sp"
                            android:layout_marginHorizontal="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                        <TextView
                            android:textSize="16sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:fontFamily="@font/ibm_plex_sans_medium"
                            android:text="@string/review"
                            android:textFontWeight="700"
                            />
                            <TextView
                                android:layout_marginStart="20sp"
                                android:textStyle="bold"
                                android:text="@string/review"
                                android:id="@+id/textView_reviewInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>


                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/comment_recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="8"
                            tools:listitem="@layout/item_comment" />

                        <LinearLayout
                            android:layout_marginVertical="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/button_regis_comment"
                                android:layout_weight="0.1"
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent">
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/imageView_star_indicator"
                                    android:src="@drawable/star_regular_icon"
                                    android:layout_width="20sp"
                                    android:layout_height="20sp"
                                    />
                                <TextView
                                    android:layout_marginHorizontal="3sp"
                                    android:id="@+id/textView_reviewScore"
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:layout_marginHorizontal="3sp"
                                    android:id="@+id/textView_reviewIndicator"
                                    android:layout_gravity="center_vertical"
                                    android:text="@string/review_indicator_webNovel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

<!--                            <Button-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:layout_gravity="center"-->

<!--                                android:text="@string/comment_register" />-->
                            </LinearLayout>

                            <!--<View
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="0.2" />-->


                            <Button
                                android:id="@+id/button_moreCommentItem"
                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"
                                android:layout_gravity="center"

                                android:layout_weight="0.1"
                                android:text="@string/more" />



                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Scrollable content -->


        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.constraintlayout.widget.ConstraintLayout>