<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".exploreActivity.ChapterShowActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:background="@color/ivory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mToolBar_bookInfo"
            style="@style/Widget.MaterialComponents.Toolbar.Primary"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/arrow_left_solid"
            app:title="@string/chapter"
            app:titleCentered="true" />
        <androidx.cardview.widget.CardView
            android:background="@color/white"
            android:layout_marginTop="10sp"
            app:cardCornerRadius="20sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="5sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

<!--            <Button-->
<!--                android:layout_marginHorizontal="10sp"-->
<!--                app:layout_constraintWidth_percent="0.45"-->
<!--                android:id="@+id/button_filter1"-->
<!--                android:layout_width="0dp"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="필터"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                app:layout_constraintTop_toTopOf="parent"-->
<!--                />-->
                <TextView
                    android:id="@+id/textView_chapterShowIndicator"
                    android:gravity="center"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.45"
                    android:text="@string/sample_chapter_string"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

            <Button
                android:layout_marginHorizontal="10sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.45"
                android:id="@+id/button_arrayOption1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/first"
                android:onClick="showPopup"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Note: A RecyclerView can also be used -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView_chapter"
        android:background="@color/ivory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            android:layout_marginHorizontal="3sp"
            android:background="@color/white"
            app:cardCornerRadius="40sp">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginHorizontal="10sp"
                android:padding="10sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/layout_chapterShow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_weight="1"
                        android:fontFamily="@font/ibm_plex_sans_medium"
                        android:text="회차" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:fontFamily="@font/ibm_plex_sans_medium"
                        android:gravity="center"
                        android:text="제목" />
                    <!-- 정렬 옵션 선택 레이아웃 , 최신순 , 등록순  옵션 선택-->
                    <LinearLayout
                        android:id="@+id/layout_arrayOption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"

                        android:layout_weight="1"
                        android:gravity="end">

                        <TextView
                            android:layout_marginEnd="10sp"
                            android:id="@+id/textView_arrayOption"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/ibm_plex_sans_medium"
                            android:gravity="end"
                            android:text="정보" />

<!--                        <ImageView-->
<!--                            android:id="@+id/imageView_array"-->
<!--                            android:layout_width="24dp"-->
<!--                            android:layout_height="24dp"-->
<!--                            android:layout_weight="1"-->
<!--                            android:src="@drawable/arraylist_icon" />-->
                    </LinearLayout>

                </LinearLayout>
                <com.google.android.material.divider.MaterialDivider
                    android:layout_marginTop="10sp"
                    app:layout_constraintTop_toBottomOf="@id/layout_chapterShow"
                    app:dividerColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
<!--                <Button-->
<!--                    android:layout_marginHorizontal="10sp"-->
<!--                    app:layout_constraintWidth_percent="0.45"-->
<!--                    android:id="@+id/button_filter"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="필터"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toTopOf="parent"-->
<!--                    />-->

<!--                <Button-->
<!--                    android:layout_marginHorizontal="10sp"-->
<!--                    app:layout_constraintTop_toTopOf="parent"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintWidth_percent="0.45"-->
<!--                    android:id="@+id/button_arrayOption"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="@+array/array_option"/>-->

                <androidx.recyclerview.widget.RecyclerView
                    android:nestedScrollingEnabled="false"
                    android:id="@+id/recyclerView_chapterList"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_chapterShow"
                    android:layout_marginVertical="10sp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:itemCount="20"
                    tools:listitem="@layout/item_chapter"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>