<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".exploreActivity.ReviewInputActivity"
    android:background="@color/ivory">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mToolBar_ReviewInput"
        style="@style/Widget.MaterialComponents.Toolbar.Primary"
        app:navigationIcon="@drawable/arrow_left_solid"
        app:title="@string/review_regis"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="5sp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_margin="10sp"
        app:cardCornerRadius="20sp"
        android:id="@+id/cardView_ratingInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mToolBar_ReviewInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"

            android:layout_height="wrap_content"
            android:padding="10sp">
            <ImageView
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/info_solid"
                android:id="@+id/button_tooltip"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_rating"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintGuide_percent="0.02"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <!--스토리-->
            <TextView
                android:fontFamily="@font/ibm_plex_sans_medium"
                android:id="@+id/textView_rating_storyIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/review_rating_story"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="@+id/rating_reviewNovel_story"
                app:layout_constraintEnd_toStartOf="@id/rating_reviewNovel_story"
                app:layout_constraintStart_toEndOf="@id/guideline_rating"
                app:layout_constraintTop_toTopOf="@+id/rating_reviewNovel_story" />

            <RatingBar
                style="@style/Widget.AppCompat.RatingBar.Indicator"
                android:numStars="5"
                android:rating="0"
                android:isIndicator="false"
                android:id="@+id/rating_reviewNovel_story"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15sp"
                android:layout_marginVertical="15sp"
                android:layout_marginTop="25sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textView_rating_storyIndicator"
                app:layout_constraintTop_toBottomOf="@id/button_tooltip" />
            <!--캐릭터-->
            <TextView
                android:fontFamily="@font/ibm_plex_sans_medium"

                android:id="@+id/textView_rating_character_Indicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/review_rating_character"
                android:textSize="18sp"

                app:layout_constraintBottom_toBottomOf="@+id/rating_reviewNovel_character"
                app:layout_constraintEnd_toStartOf="@id/rating_reviewNovel_character"
                app:layout_constraintStart_toEndOf="@id/guideline_rating"
                app:layout_constraintTop_toTopOf="@+id/rating_reviewNovel_character" />

            <RatingBar
                style="@style/Widget.AppCompat.RatingBar.Indicator"
                android:numStars="5"
                android:isIndicator="false"
                android:id="@+id/rating_reviewNovel_character"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textView_rating_character_Indicator"
                app:layout_constraintTop_toBottomOf="@id/rating_reviewNovel_story" />
            <!--세계관-->
            <TextView
                android:fontFamily="@font/ibm_plex_sans_medium"

                android:id="@+id/textView_rating_worldIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/review_rating_world"
                android:textSize="18sp"

                app:layout_constraintBottom_toBottomOf="@+id/rating_reviewNovel_world"
                app:layout_constraintEnd_toStartOf="@id/rating_reviewNovel_world"
                app:layout_constraintStart_toEndOf="@id/guideline_rating"
                app:layout_constraintTop_toTopOf="@+id/rating_reviewNovel_world" />

            <RatingBar
                style="@style/Widget.AppCompat.RatingBar.Indicator"
                android:numStars="5"
                android:isIndicator="false"
                android:id="@+id/rating_reviewNovel_world"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textView_rating_worldIndicator"
                app:layout_constraintTop_toBottomOf="@id/rating_reviewNovel_character" />
            <TextView
                android:fontFamily="@font/ibm_plex_sans_medium"

                android:id="@+id/textView_rating_qualityIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/review_rating_quality"
                android:textSize="18sp"

                app:layout_constraintBottom_toBottomOf="@+id/rating_reviewNovel_quality"
                app:layout_constraintEnd_toStartOf="@id/rating_reviewNovel_quality"
                app:layout_constraintStart_toEndOf="@id/guideline_rating"
                app:layout_constraintTop_toTopOf="@+id/rating_reviewNovel_quality" />

            <RatingBar
                style="@style/Widget.AppCompat.RatingBar.Indicator"
                android:numStars="5"
                android:isIndicator="false"
                android:id="@+id/rating_reviewNovel_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textView_rating_qualityIndicator"
                app:layout_constraintTop_toBottomOf="@id/rating_reviewNovel_world" />

            <TextView
                android:fontFamily="@font/ibm_plex_sans_medium"

                android:id="@+id/textView_rating_updateIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/review_rating_update"
                android:textSize="18sp"

                app:layout_constraintBottom_toBottomOf="@+id/rating_reviewNovel_update"
                app:layout_constraintEnd_toStartOf="@id/rating_reviewNovel_update"
                app:layout_constraintStart_toEndOf="@id/guideline_rating"
                app:layout_constraintTop_toTopOf="@+id/rating_reviewNovel_update" />

            <RatingBar
                style="@style/Widget.AppCompat.RatingBar.Indicator"
                android:numStars="5"
                android:isIndicator="false"
                android:id="@+id/rating_reviewNovel_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15sp"
                app:layout_constraintBottom_toTopOf="@id/divider_score"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textView_rating_updateIndicator"
                app:layout_constraintTop_toBottomOf="@id/rating_reviewNovel_quality" />
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider_score"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rating_reviewNovel_update" />

            <TextView
                android:fontFamily="@font/ibm_plex_sans_medium"
                android:textStyle="bold"
                android:layout_marginVertical="10sp"
                android:id="@+id/textView_rating_overallIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/review_rating_total"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/guideline_rating"
                app:layout_constraintTop_toBottomOf="@id/divider_score" />

            <TextView
                android:textStyle="bold"
                android:fontFamily="@font/ibm_plex_sans_medium"
                android:textSize="16sp"
                android:layout_marginVertical="10sp"
                android:layout_marginHorizontal="20sp"
                android:id="@+id/textView_totalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/review_rating"
                app:layout_constraintBottom_toBottomOf="@+id/textView_rating_overallIndicator"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textView_rating_overallIndicator" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        app:cardBackgroundColor="@color/gray_trans"
        android:layout_margin="10sp"
        app:cardCornerRadius="20sp"
        android:id="@+id/cardView_reviewTextInput"
        app:layout_constraintTop_toBottomOf="@id/cardView_ratingInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_margin="20sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textView_reviewInput"
                    android:textSize="15sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100sp"
                    android:textColorHint="@color/white"
                    android:hint="@string/hint_review" />
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_reviewRegis"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/save_floppy_icon"
        android:layout_margin="15sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/agree" />


</androidx.constraintlayout.widget.ConstraintLayout>