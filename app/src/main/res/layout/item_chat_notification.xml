<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="16dp">
    <!-- 입장,퇴장의 알림을 나타내기 위해서 사용하는 메세지 other, me 의 chat item 에 존재하는 알림 메세지 기능을 매번
    onBind 에서 초기화 해야하는 것이 성능적으로 문제가 있지 않을까 생각해서 만들었음 임시-->
    <androidx.cardview.widget.CardView
        android:foregroundGravity="center_horizontal"
        android:backgroundTint="@color/gray_trans"
        android:id="@+id/layout_chat_date_notifications"
        android:layout_marginTop="32dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:paddingHorizontal="10sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:padding="5sp"
                android:id="@+id/text_chat_date_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="June 10"
                android:textColor="#030F14"
                />
        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:foregroundGravity="center_horizontal"
        android:backgroundTint="@color/gray_trans"
        android:id="@+id/layout_chat_notifications"
        android:layout_marginTop="32dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_chat_date_notifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible">
    <LinearLayout
        android:paddingHorizontal="10sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:padding="5sp"
            android:id="@+id/text_chat_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닉네임 입장하였습니다"
            android:textColor="#030F14"
            />
    </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>