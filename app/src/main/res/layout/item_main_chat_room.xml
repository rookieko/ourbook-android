<?xml version="1.0" encoding="utf-8"?>
<!-- 리사이클러뷰에 나타낼 등록한 채팅방 아이템  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5sp"
    android:layout_margin="5sp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline1"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.78"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_marginHorizontal="10sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline1"
        android:layout_width="100sp"
        android:layout_height="100sp"
        android:id="@+id/item_main_chatRoom_imageCover"
        android:src="@drawable/sample_bookcover"
        />
    <TextView
        android:layout_marginEnd="10sp"
        android:layout_marginStart="5sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:id="@+id/item_main_chatRoom_name"
        android:text="@string/chat_room_name"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <TextView
        android:maxLines="1"
        android:textColor="@color/gray_light"
        android:layout_marginStart="3sp"
        android:id="@+id/item_main_chatRoom_numberPeople"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_main_chatRoom_type_imageView"
        android:text="@string/chat_room_numberPeople"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        app:layout_constraintStart_toEndOf="@id/guideline2"
        android:src="@drawable/round_boy_24"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/item_main_chatRoom_type_imageView"
        android:layout_width="20sp"
        android:layout_height="20sp"/>
    <TextView
        android:layout_marginStart="5sp"

        app:layout_constraintTop_toBottomOf="@id/item_main_chatRoom_name"
        app:layout_constraintStart_toEndOf="@+id/guideline1"
        android:text="@string/chat_novel_tag"
        android:id="@+id/item_main_chatRoom_novelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/item_main_chatRoom_lastMessage_layout"
        android:layout_marginHorizontal="5sp"
        android:layout_marginVertical="10sp"
        android:layout_width="0dp"
        app:cardBackgroundColor="@color/light_ivory"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/item_main_chatRoom_novelName"
        app:layout_constraintStart_toEndOf="@id/guideline1"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:layout_margin="5sp"
                android:visibility="visible"
                android:text="@string/chat_lastMessage"
                android:id="@+id/item_main_chatRoom_lastMessage"
                android:layout_width="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
<!--    <TextView-->
<!--        android:layout_marginStart="16sp"-->
<!--        android:visibility="visible"-->
<!--        android:padding="3sp"-->
<!--        android:layout_marginVertical="10sp"-->
<!--        app:layout_constraintEnd_toStartOf="@+id/guideline2"-->
<!--        app:layout_constraintTop_toBottomOf="@id/item_main_chatRoom_novelName"-->
<!--        app:layout_constraintStart_toEndOf="@id/guideline1"-->
