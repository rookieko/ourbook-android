<!--        android:layout_height="wrap_content"-->
<!--        android:background="@drawable/view_border"/>-->

    <!--todo 시간 , 마지막으로온 메세지의 시간 -->
    <TextView
        android:visibility="invisible"
        android:textStyle="italic"
        android:id="@+id/item_main_chatRoom_lastTime"
        app:layout_constraintBottom_toTopOf="@+id/item_main_chatRoom_lastMessage_layout"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/sample_date_text"
        android:textColor="@color/gray_light"
        android:layout_marginBottom="5sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        app:layout_constraintStart_toEndOf="@id/guideline2"
        android:id="@+id/item_main_chatRoom_message_icon"
        app:layout_constraintTop_toTopOf="@id/item_main_chatRoom_numberNewMessage"
        app:layout_constraintBottom_toBottomOf="@id/item_main_chatRoom_numberNewMessage"
        android:src="@drawable/outline_chat_bubble_24"
        android:layout_marginStart="10sp"
        android:layout_width="20sp"
        android:layout_height="20sp"/>
    <TextView
        android:textStyle="bold"
        android:layout_marginEnd="10sp"
        android:layout_marginStart="5sp"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_main_chatRoom_lastMessage_layout"
        app:layout_constraintBottom_toBottomOf="@+id/item_main_chatRoom_lastMessage_layout"
        app:layout_constraintStart_toEndOf="@+id/item_main_chatRoom_message_icon"
        android:id="@+id/item_main_chatRoom_numberNewMessage"
        android:textColor="@color/red_message"
        android:text="@string/sample_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>