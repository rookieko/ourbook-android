<?xml version="1.0" encoding="utf-8"?>
<!-- 리사이클러뷰에 나타낼 검색 전 채팅방 아이템  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5sp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline1"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.78"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_margin="10sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:maxHeight="80sp"
        android:maxWidth="80sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/item_search_chatRoom_imageCover"
        android:src="@drawable/sample_bookcover"
        app:layout_constraintEnd_toStartOf="@id/guideline1"
        />
    <TextView
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:id="@+id/item_search_chatRoom_name"
        android:text="@string/chat_room_name"
        app:layout_constraintEnd_toStartOf="@id/item_search_chatRoom_numberPeople"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <TextView
        app:layout_constraintEnd_toStartOf="@+id/item_main_chatRoom_type_imageView"
        android:maxLines="1"
        android:textColor="@color/gray_light"
        android:layout_marginStart="10sp"
        android:id="@+id/item_search_chatRoom_numberPeople"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_search_chatRoom_name"
        android:text="@string/chat_room_numberPeople"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_margin="5sp"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        android:src="@drawable/lock_solid"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/item_main_chatRoom_type_imageView"
        android:layout_width="15sp"
        android:layout_height="15sp"/>
    <TextView
        app:layout_constraintTop_toBottomOf="@id/item_search_chatRoom_name"
        app:layout_constraintStart_toEndOf="@+id/guideline1"
        android:text="@string/chat_novel_tag"
        android:id="@+id/item_search_chatRoom_novelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <!-- 웹소설 소개 내용 출력-->
    <com.google.android.material.card.MaterialCardView
        android:visibility="visible"
        android:id="@+id/item_search_chatRoom_introduce_layout"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/item_search_chatRoom_novelName"
        app:layout_constraintStart_toEndOf="@id/guideline1"
        android:layout_width="0dp"
        android:background="@color/gray"
        android:layout_margin="10sp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:background="@color/light_ivory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:padding="5sp"

                android:layout_marginVertical="10sp"

                android:text="@string/chat_lastMessage"
                android:id="@+id/item_search_chatRoom_introduce"
                android:layout_width="wrap_content"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                android:ellipsize="end"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
<!--    <TextView-->
<!--        android:visibility="invisible"-->

<!--        android:layout_marginVertical="10sp"-->
<!--        app:layout_constraintEnd_toStartOf="@+id/guideline2"-->
<!--        app:layout_constraintTop_toBottomOf="@id/item_search_chatRoom_novelName"-->
<!--        app:layout_constraintStart_toEndOf="@id/guideline1"-->
<!--        android:text="@string/chat_lastMessage"-->
<!--        android:id="@+id/item_search_chatRoom_introduce"-->
<!--        android:layout_width="0dp"-->
<!--        android:maxLines="2"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        android:ellipsize="end"-->
<!--        android:layout_height="wrap_content"/>-->
    <TextView
        android:text="@string/chat_room_create_date_indicator"
        android:id="@+id/item_search_chatRoom_date_indicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline2"
        />
    <!-- 생성 날짜 -->
    <TextView
        android:id="@+id/item_search_chatRoom_date"
        android:text="@string/sample_date_text"
        app:layout_constraintTop_toBottomOf="@id/item_search_chatRoom_date_indicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>


</androidx.constraintlayout.widget.ConstraintLayout>